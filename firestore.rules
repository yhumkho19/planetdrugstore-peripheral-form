rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && !request.auth.token.email.matches('.*@staff[.]planetdrugstore[.]local$');
    }

    match /employees/{staffId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if !exists(/databases/$(database)/documents/employees/$(staffId))
                    && request.resource.data.staffId is string
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.department is string
                    && request.resource.data.passwordHash is string;
      allow update, delete: if isAdmin();
    }

    match /entries/{entryId} {
      allow read, write: if true;
    }
    match /reservedControlNos/{controlNo} {
      allow read, write: if true;
    }
    match /liveSessions/{controlNo} {
      allow read, write: if true;
    }
    match /receivers/{id} {
      allow read, write: if true;
    }
    match /returners/{id} {
      allow read, write: if true;
    }
    match /venues/{id} {
      allow read, write: if true;
    }
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /preparers/{id} {
      allow read, write: if isAdmin();
    }
    match /eventSchedule/{docId} {
      allow read, write: if true;
    }
  }
}