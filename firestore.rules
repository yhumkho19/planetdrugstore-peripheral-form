                  && request.resource.data.emoji == '😮'
                  && request.resource.data.label == 'Wow')
                || (request.resource.data.reactionKey == 'angry'
                  && request.resource.data.emoji == '😡'
                  && request.resource.data.label == 'Angry')
                || (request.resource.data.reactionKey == 'like'
                  && request.resource.data.emoji == '👍'
                  && request.resource.data.label == 'Like')
                || (request.resource.data.reactionKey == 'good-job'
                  && request.resource.data.emoji == '🎉'
                  && request.resource.data.label == 'Good job!')
                || (request.resource.data.reactionKey == 'nice'
                  && request.resource.data.emoji == '✨'
                  && request.resource.data.label == 'Nice!')
                || (request.resource.data.reactionKey == 'better-luck'
                  && request.resource.data.emoji == '💪'
                  && request.resource.data.label == 'Better luck next time')
              )
              && request.resource.data.reactedBy == request.auth.token.get('email', '')
              && request.resource.data.reactedAt == request.time;
          }
          allow read: if isViewer() || isBillingScheduleOwner()
            || dailyTaskEmployee(get(parentTaskPath()).data.staffId);
          allow create, update: if isBillingScheduleOwner()
            && reactionId == 'billingHead'
            && exists(parentTaskPath())
            && validTaskReaction();
          allow delete: if isBillingScheduleOwner() && reactionId == 'billingHead';
        }

        match /history/{editId} {
          function parentTaskPath() {
            return /databases/$(database)/documents/dailyTasks/$(taskId);
          }
          allow read: if isViewer() || isBillingScheduleOwner()
            || dailyTaskEmployee(get(parentTaskPath()).data.staffId);
          allow create: if dailyTaskEmployee(get(parentTaskPath()).data.staffId)
            && get(parentTaskPath()).data.status in ['', 'Pending', 'For Compliance']
            && request.resource.data.keys().hasOnly(['before', 'after', 'editedBy', 'editedAt'])
            && dailyTaskHistorySnapshotValid(request.resource.data.before)
            && dailyTaskHistorySnapshotValid(request.resource.data.after)
            && request.resource.data.editedBy == request.auth.token.staffId
            && request.resource.data.editedAt == request.time
            && getAfter(parentTaskPath()).data.lastEditId == editId
            && getAfter(parentTaskPath()).data.updatedAt == request.time
            && request.resource.data.before.date == get(parentTaskPath()).data.date
            && request.resource.data.before.time == get(parentTaskPath()).data.time
            && request.resource.data.before.description == get(parentTaskPath()).data.description
            && request.resource.data.before.descriptionOther == get(parentTaskPath()).data.descriptionOther
            && request.resource.data.before.location == get(parentTaskPath()).data.location
            && request.resource.data.before.status == get(parentTaskPath()).data.status
            && request.resource.data.before.remarks == get(parentTaskPath()).data.remarks
            && request.resource.data.before.attachments == get(parentTaskPath()).data.get('attachments', [])
            && request.resource.data.after.date == getAfter(parentTaskPath()).data.date
            && request.resource.data.after.time == getAfter(parentTaskPath()).data.time
            && request.resource.data.after.description == getAfter(parentTaskPath()).data.description
            && request.resource.data.after.descriptionOther == getAfter(parentTaskPath()).data.descriptionOther
            && request.resource.data.after.location == getAfter(parentTaskPath()).data.location
            && request.resource.data.after.status == getAfter(parentTaskPath()).data.status
            && request.resource.data.after.remarks == getAfter(parentTaskPath()).data.remarks
            && !request.resource.data.after.keys().hasAny(['attachments']);
          allow update: if false;
          allow delete: if isBillingScheduleOwner();
        }

        match /comments/{commentId} {
          function parentTaskPath() {
            return /databases/$(database)/documents/dailyTasks/$(taskId);
          }
          function parentCommentPath() {
            return /databases/$(database)/documents/dailyTasks/$(taskId)/comments/$(commentId);
          }
          function validConversationReceiptUpdate() {
            let changed = request.resource.data.diff(resource.data).affectedKeys();
            return changed.hasAny(['deliveredAt', 'seenAt'])
              && changed.hasOnly(['deliveredAt', 'seenAt'])
              && (changed.hasAny(['deliveredAt'])
                ? (!('deliveredAt' in resource.data)
                  && request.resource.data.deliveredAt == request.time)
                : request.resource.data.get('deliveredAt', null)
                  == resource.data.get('deliveredAt', null))
              && (changed.hasAny(['seenAt'])
                ? (!('seenAt' in resource.data)
                  && request.resource.data.seenAt == request.time)
                : request.resource.data.get('seenAt', null)
                  == resource.data.get('seenAt', null))
              && (!('seenAt' in request.resource.data)
                || request.resource.data.get('deliveredAt', null) is timestamp);
          }
          allow read: if isViewer() || isBillingScheduleOwner()
            || dailyTaskEmployee(get(parentTaskPath()).data.staffId);
          allow create: if isBillingScheduleOwner()
            && request.resource.data.keys().hasOnly([
              'staffId', 'employeeName', 'taskId', 'taskDescription',
              'taskDescriptionOther', 'taskDate', 'taskTime', 'taskLocation',
              'comment', 'commentedBy', 'commentedAt'
            ])
            && request.resource.data.keys().hasAll([
              'staffId', 'employeeName', 'taskId', 'taskDescription',
              'taskDescriptionOther', 'taskDate', 'taskTime', 'taskLocation',
              'comment', 'commentedBy', 'commentedAt'
            ])
            && exists(parentTaskPath())
            && existsAfter(parentTaskPath())
            && request.resource.data.staffId == get(parentTaskPath()).data.staffId
            && dailyTaskBillingEmployee(request.resource.data.staffId)
            && request.resource.data.employeeName == get(parentTaskPath()).data.name
            && request.resource.data.taskId == taskId
            && request.resource.data.taskDescription == get(parentTaskPath()).data.description
            && request.resource.data.taskDescriptionOther == get(parentTaskPath()).data.descriptionOther
            && request.resource.data.taskDate == get(parentTaskPath()).data.date
            && request.resource.data.taskTime == get(parentTaskPath()).data.time
            && request.resource.data.taskLocation == get(parentTaskPath()).data.location
            && request.resource.data.comment is string
            && request.resource.data.comment.size() > 0
            && request.resource.data.comment.size() <= 1000
            && request.resource.data.commentedBy == request.auth.token.get('email', '')
            && request.resource.data.commentedAt == request.time;
          allow update: if dailyTaskEmployee(get(parentTaskPath()).data.staffId)
            && validConversationReceiptUpdate();
          allow delete: if isBillingScheduleOwner();

          match /typing/{typingId} {
            function validTypingPresence() {
              return request.resource.data.keys().hasOnly([
                  'authorRole', 'isTyping', 'updatedAt'
                ])
                && request.resource.data.keys().hasAll([
                  'authorRole', 'isTyping', 'updatedAt'
                ])
                && request.resource.data.isTyping is bool
                && request.resource.data.updatedAt == request.time
                && exists(parentCommentPath())
                && ((isBillingScheduleOwner()
                    && request.resource.data.authorRole == 'billingHead')
                  || (dailyTaskEmployee(get(parentTaskPath()).data.staffId)
                    && request.resource.data.authorRole == 'employee'));
            }
            allow read: if isViewer() || isBillingScheduleOwner()
              || dailyTaskEmployee(get(parentTaskPath()).data.staffId);
            allow create: if request.auth != null
              && typingId == request.auth.uid
              && validTypingPresence();
            allow update: if request.auth != null
              && typingId == request.auth.uid
              && resource.data.authorRole == request.resource.data.authorRole
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['isTyping', 'updatedAt'])
              && validTypingPresence();
            allow delete: if isBillingScheduleOwner()
              || (request.auth != null
                && typingId == request.auth.uid
                && resource.data.authorRole == 'employee'
                && dailyTaskEmployee(get(parentTaskPath()).data.staffId));
          }

          match /replies/{replyId} {
            function parentTaskPath() {
              return /databases/$(database)/documents/dailyTasks/$(taskId);
            }
            function parentCommentPath() {
              return /databases/$(database)/documents/dailyTasks/$(taskId)/comments/$(commentId);
            }
            allow read: if isViewer() || isBillingScheduleOwner()
              || dailyTaskEmployee(get(parentTaskPath()).data.staffId);
            allow create: if exists(parentTaskPath())
              && exists(parentCommentPath())
              && request.resource.data.keys().hasOnly([
                'taskId', 'commentId', 'staffId', 'employeeName', 'authorRole',
                'reply', 'repliedBy', 'taskDescription', 'taskDescriptionOther',
                'taskDate', 'taskTime', 'taskLocation', 'repliedAt'
              ])
              && request.resource.data.keys().hasAll([
                'taskId', 'commentId', 'staffId', 'employeeName', 'authorRole',
                'reply', 'repliedBy', 'taskDescription', 'taskDescriptionOther',
                'taskDate', 'taskTime', 'taskLocation', 'repliedAt'
              ])
              && request.resource.data.taskId == taskId
              && request.resource.data.commentId == commentId
              && request.resource.data.staffId == get(parentTaskPath()).data.staffId
              && request.resource.data.employeeName == get(parentTaskPath()).data.name
              && request.resource.data.reply is string
              && request.resource.data.reply.size() > 0
              && request.resource.data.reply.size() <= 1000
              && request.resource.data.taskDescription == get(parentTaskPath()).data.description
              && request.resource.data.taskDescriptionOther == get(parentTaskPath()).data.descriptionOther
              && request.resource.data.taskDate == get(parentTaskPath()).data.date
              && request.resource.data.taskTime == get(parentTaskPath()).data.time
              && request.resource.data.taskLocation == get(parentTaskPath()).data.location
              && request.resource.data.repliedAt == request.time
              && ((dailyTaskEmployee(get(parentTaskPath()).data.staffId)
                  && request.resource.data.authorRole == 'employee'
                  && request.resource.data.repliedBy == request.auth.token.staffId)
                || (isBillingScheduleOwner()
                  && request.resource.data.authorRole == 'billingHead'
                  && request.resource.data.repliedBy == request.auth.token.get('email', '')));
            allow update: if ((resource.data.authorRole == 'billingHead'
                && dailyTaskEmployee(get(parentTaskPath()).data.staffId))
              || (resource.data.authorRole == 'employee' && isBillingScheduleOwner()))
              && validConversationReceiptUpdate();
            allow delete: if isBillingScheduleOwner();
          }
        }
      }

      match /dailyTaskDeletionNotifications/{notificationId} {
        allow create: if isBillingScheduleOwner()
          && request.resource.data.keys().hasOnly([
            'staffId', 'employeeName', 'taskId', 'submission',
            'reason', 'deletedBy', 'deletedAt', 'readAt'
          ])
          && request.resource.data.keys().hasAll([
            'staffId', 'employeeName', 'taskId', 'submission',
            'reason', 'deletedBy', 'deletedAt', 'readAt'
          ])
          && request.resource.data.staffId is string
          && dailyTaskBillingEmployee(request.resource.data.staffId)
          && request.resource.data.employeeName is string
          && request.resource.data.employeeName.size() > 0
          && request.resource.data.taskId is string
          && request.resource.data.taskId.size() > 0
          && !existsAfter(
            /databases/$(database)/documents/dailyTasks/$(request.resource.data.taskId)
          )
          && request.resource.data.submission is map
          && request.resource.data.submission == get(
            /databases/$(database)/documents/dailyTasks/$(request.resource.data.taskId)
          ).data
          && request.resource.data.submission.staffId == request.resource.data.staffId
          && request.resource.data.submission.name == request.resource.data.employeeName
          && request.resource.data.reason is string
          && request.resource.data.reason.size() > 0
          && request.resource.data.reason.size() <= 1000
          && request.resource.data.deletedBy == request.auth.token.get('email', '')
          && request.resource.data.deletedAt == request.time
          && request.resource.data.readAt == null;
        allow read: if isViewer() || isBillingScheduleOwner()
          || dailyTaskEmployee(resource.data.staffId);
        allow update: if dailyTaskEmployee(resource.data.staffId)
          && resource.data.readAt == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
        allow delete: if dailyTaskEmployee(resource.data.staffId);
      }

      match /dailyTaskCommentNotifications/{commentId} {
        function commentPath() {
          return /databases/$(database)/documents/dailyTasks/$(request.resource.data.taskId)/comments/$(request.resource.data.commentId);
        }
        allow create: if isBillingScheduleOwner()
          && request.resource.data.keys().hasOnly([
            'commentId', 'staffId', 'employeeName', 'taskId', 'taskDescription',
            'taskDescriptionOther', 'taskDate', 'taskTime', 'taskLocation',
            'comment', 'commentedBy', 'commentedAt', 'readAt'
          ])
          && request.resource.data.keys().hasAll([
            'commentId', 'staffId', 'employeeName', 'taskId', 'taskDescription',
            'taskDescriptionOther', 'taskDate', 'taskTime', 'taskLocation',
            'comment', 'commentedBy', 'commentedAt', 'readAt'
          ])
          && request.resource.data.taskId is string
          && request.resource.data.taskId.size() > 0
          && request.resource.data.commentId is string
          && request.resource.data.commentId.size() > 0
          && existsAfter(commentPath())
          && request.resource.data.staffId == getAfter(commentPath()).data.staffId
          && dailyTaskBillingEmployee(request.resource.data.staffId)
          && request.resource.data.employeeName == getAfter(commentPath()).data.employeeName
          && request.resource.data.taskDescription == getAfter(commentPath()).data.taskDescription
          && request.resource.data.taskDescriptionOther == getAfter(commentPath()).data.taskDescriptionOther
          && request.resource.data.taskDate == getAfter(commentPath()).data.taskDate
          && request.resource.data.taskTime == getAfter(commentPath()).data.taskTime
          && request.resource.data.taskLocation == getAfter(commentPath()).data.taskLocation
          && request.resource.data.comment == getAfter(commentPath()).data.comment
          && request.resource.data.commentedBy == getAfter(commentPath()).data.commentedBy
          && request.resource.data.commentedAt == getAfter(commentPath()).data.commentedAt
          && request.resource.data.commentedAt == request.time
          && request.resource.data.readAt == null;
        allow read: if isViewer() || isBillingScheduleOwner() || dailyTaskEmployee(resource.data.staffId);
        allow update: if dailyTaskEmployee(resource.data.staffId)
          && resource.data.readAt == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
        allow delete: if isBillingScheduleOwner() || dailyTaskEmployee(resource.data.staffId);
      }

      match /dailyTaskReactionNotifications/{taskId} {
        function taskPath() {
          return /databases/$(database)/documents/dailyTasks/$(taskId);
        }
        function reactionPath() {
          return /databases/$(database)/documents/dailyTasks/$(taskId)/reactions/billingHead;
        }
        function reactionNotificationMatchesTask() {
          return existsAfter(taskPath())
            && existsAfter(reactionPath())
            && request.resource.data.staffId == getAfter(taskPath()).data.staffId
            && dailyTaskBillingEmployee(request.resource.data.staffId)
            && request.resource.data.employeeName == getAfter(taskPath()).data.name
            && request.resource.data.taskDescription == getAfter(taskPath()).data.description
            && request.resource.data.taskDescriptionOther
              == getAfter(taskPath()).data.get('descriptionOther', '')
            && request.resource.data.taskDate == getAfter(taskPath()).data.date
            && request.resource.data.taskTime == getAfter(taskPath()).data.time
            && request.resource.data.reactionKey == getAfter(reactionPath()).data.reactionKey
            && request.resource.data.emoji == getAfter(reactionPath()).data.emoji
            && request.resource.data.label == getAfter(reactionPath()).data.label
            && request.resource.data.reactedBy == getAfter(reactionPath()).data.reactedBy
            && request.resource.data.reactedAt == getAfter(reactionPath()).data.reactedAt
            && request.resource.data.reactedAt == request.time
            && request.resource.data.reactionChanged
              == (exists(reactionPath())
                && get(reactionPath()).data.reactionKey != request.resource.data.reactionKey)
            && (request.resource.data.reactionChanged
              ? request.resource.data.previousReactionKey == get(reactionPath()).data.reactionKey
                && request.resource.data.previousReactionEmoji == get(reactionPath()).data.emoji
                && request.resource.data.previousReactionLabel == get(reactionPath()).data.label
              : request.resource.data.previousReactionKey == ''
                && request.resource.data.previousReactionEmoji == ''
                && request.resource.data.previousReactionLabel == '')
            && request.resource.data.readAt == null;
        }
        allow read: if isViewer() || isBillingScheduleOwner()
          || dailyTaskEmployee(resource.data.staffId);
        allow create, update: if isBillingScheduleOwner()
          && request.resource.data.keys().hasOnly([
            'taskId', 'staffId', 'employeeName', 'taskDescription',
            'taskDescriptionOther', 'taskDate', 'taskTime', 'reactionKey',
            'emoji', 'label', 'reactedBy', 'reactedAt', 'reactionChanged',
            'previousReactionEmoji', 'previousReactionLabel',
            'previousReactionKey', 'readAt'
          ])
          && request.resource.data.keys().hasAll([
            'taskId', 'staffId', 'employeeName', 'taskDescription',
            'taskDescriptionOther', 'taskDate', 'taskTime', 'reactionKey',
            'emoji', 'label', 'reactedBy', 'reactedAt', 'reactionChanged',
            'previousReactionEmoji', 'previousReactionLabel',
            'previousReactionKey', 'readAt'
          ])
          && request.resource.data.taskId == taskId
          && reactionNotificationMatchesTask();
        allow update: if dailyTaskEmployee(resource.data.staffId)
          && resource.data.readAt == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
        allow delete: if isBillingScheduleOwner() || dailyTaskEmployee(resource.data.staffId);
      }

      match /dailyTaskReplyNotifications/{notificationId} {
        function replyPath() {
          return /databases/$(database)/documents/dailyTasks/$(request.resource.data.taskId)/comments/$(request.resource.data.commentId)/replies/$(request.resource.data.replyId);
        }
        allow create: if dailyTaskEmployee(request.resource.data.staffId)
          && request.resource.data.keys().hasOnly([
            'replyId', 'taskId', 'commentId', 'staffId', 'employeeName', 'authorRole',
            'reply', 'repliedBy', 'taskDescription', 'taskDescriptionOther',
            'taskDate', 'taskTime', 'taskLocation', 'repliedAt', 'recipientRole', 'readAt'
          ])
          && request.resource.data.keys().hasAll([
            'replyId', 'taskId', 'commentId', 'staffId', 'employeeName', 'authorRole',
            'reply', 'repliedBy', 'taskDescription', 'taskDescriptionOther',
            'taskDate', 'taskTime', 'taskLocation', 'repliedAt', 'recipientRole', 'readAt'
          ])
          && request.resource.data.replyId is string
          && request.resource.data.replyId.size() > 0
          && existsAfter(replyPath())
          && request.resource.data.taskId == getAfter(replyPath()).data.taskId
          && request.resource.data.commentId == getAfter(replyPath()).data.commentId
          && request.resource.data.staffId == getAfter(replyPath()).data.staffId
          && request.resource.data.employeeName == getAfter(replyPath()).data.employeeName
          && request.resource.data.authorRole == 'employee'
          && request.resource.data.authorRole == getAfter(replyPath()).data.authorRole
          && request.resource.data.recipientRole == 'billingHead'
          && request.resource.data.reply == getAfter(replyPath()).data.reply
          && request.resource.data.repliedBy == getAfter(replyPath()).data.repliedBy
          && request.resource.data.taskDescription == getAfter(replyPath()).data.taskDescription
          && request.resource.data.taskDescriptionOther == getAfter(replyPath()).data.taskDescriptionOther
          && request.resource.data.taskDate == getAfter(replyPath()).data.taskDate
          && request.resource.data.taskTime == getAfter(replyPath()).data.taskTime
          && request.resource.data.taskLocation == getAfter(replyPath()).data.taskLocation
          && request.resource.data.repliedAt == getAfter(replyPath()).data.repliedAt
          && request.resource.data.repliedAt == request.time
          && request.resource.data.readAt == null;
        allow read: if isViewer() || isBillingScheduleOwner();
        allow update: if isBillingScheduleOwner()
          && resource.data.readAt == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
        allow delete: if isBillingScheduleOwner();
      }

      match /dailyTaskHeadReplyNotifications/{notificationId} {
        function replyPath() {
          return /databases/$(database)/documents/dailyTasks/$(request.resource.data.taskId)/comments/$(request.resource.data.commentId)/replies/$(request.resource.data.replyId);
        }
        allow create: if isBillingScheduleOwner()
          && request.resource.data.keys().hasOnly([
            'replyId', 'taskId', 'commentId', 'staffId', 'employeeName', 'authorRole',
            'reply', 'repliedBy', 'taskDescription', 'taskDescriptionOther',
            'taskDate', 'taskTime', 'taskLocation', 'repliedAt', 'recipientRole', 'readAt'
          ])
          && request.resource.data.keys().hasAll([
            'replyId', 'taskId', 'commentId', 'staffId', 'employeeName', 'authorRole',
            'reply', 'repliedBy', 'taskDescription', 'taskDescriptionOther',
            'taskDate', 'taskTime', 'taskLocation', 'repliedAt', 'recipientRole', 'readAt'
          ])
          && request.resource.data.replyId is string
          && request.resource.data.replyId.size() > 0
          && existsAfter(replyPath())
          && request.resource.data.taskId == getAfter(replyPath()).data.taskId
          && request.resource.data.commentId == getAfter(replyPath()).data.commentId
          && request.resource.data.staffId == getAfter(replyPath()).data.staffId
          && dailyTaskBillingEmployee(request.resource.data.staffId)
          && request.resource.data.employeeName == getAfter(replyPath()).data.employeeName
          && request.resource.data.authorRole == 'billingHead'
          && request.resource.data.authorRole == getAfter(replyPath()).data.authorRole
          && request.resource.data.reply == getAfter(replyPath()).data.reply
          && request.resource.data.repliedBy == getAfter(replyPath()).data.repliedBy
          && request.resource.data.taskDescription == getAfter(replyPath()).data.taskDescription
          && request.resource.data.taskDescriptionOther == getAfter(replyPath()).data.taskDescriptionOther
          && request.resource.data.taskDate == getAfter(replyPath()).data.taskDate
          && request.resource.data.taskTime == getAfter(replyPath()).data.taskTime
          && request.resource.data.taskLocation == getAfter(replyPath()).data.taskLocation
          && request.resource.data.repliedAt == getAfter(replyPath()).data.repliedAt
          && request.resource.data.repliedAt == request.time
          && request.resource.data.recipientRole == 'employee'
          && request.resource.data.readAt == null;
        allow read: if isViewer() || isBillingScheduleOwner() || dailyTaskEmployee(resource.data.staffId);
        allow update: if dailyTaskEmployee(resource.data.staffId)
          && resource.data.readAt == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
        allow delete: if isBillingScheduleOwner() || dailyTaskEmployee(resource.data.staffId);
      }
    match /{document=**} {
      allow read: if isViewer();
    }
  }
}
