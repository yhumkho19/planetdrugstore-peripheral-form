rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && !request.auth.token.email.matches('.*@staff[.]planetdrugstore[.]local$');
    }

    match /employees/{staffId} {
      allow get: if true;
      allow list: if isAdmin();

      // Self-signup: no Firebase Auth session exists for employees, so this
      // has to stay open — but guarded so it can only CREATE a brand-new
      // Staff ID (can't overwrite someone else's existing account this way)
      // and must include the expected fields.
      allow create: if !exists(/databases/$(database)/documents/employees/$(staffId))
                    && request.resource.data.staffId is string
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.department is string
                    && request.resource.data.passwordHash is string;

      // Changing/deleting an account (Change Password modal, Delete Account
      // button) stays Admin-only.
      allow update, delete: if isAdmin();
    }

    match /entries/{entryId} {
      allow read, write: if true;
    }
    match /reservedControlNos/{controlNo} {
      allow read, write: if true;
    }
    match /liveSessions/{controlNo} {
      allow read, write: if true;
    }
    match /receivers/{id} {
      allow read, write: if true;
    }
    match /returners/{id} {
      allow read, write: if true;
    }
    match /venues/{id} {
      allow read, write: if true;
    }
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /preparers/{id} {
      allow read, write: if isAdmin();
    }
  }
}