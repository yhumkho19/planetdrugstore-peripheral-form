rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && !request.auth.token.email.matches('.*@staff[.]planetdrugstore[.]local$');
    }

    match /employees/{staffId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if !exists(/databases/$(database)/documents/employees/$(staffId))
                    && request.resource.data.staffId is string
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.department is string
                    && request.resource.data.passwordHash is string;
      allow update, delete: if isAdmin();
    }

    match /entries/{entryId} {
      allow read, write: if true;
    }
    match /reservedControlNos/{controlNo} {
      allow read, write: if true;
    }
    match /liveSessions/{controlNo} {
      allow read, write: if true;
    }
    match /receivers/{id} {
      allow read, write: if true;
    }
    match /returners/{id} {
      allow read, write: if true;
    }
    match /venues/{id} {
      allow read, write: if true;
    }
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /preparers/{id} {
      allow read, write: if isAdmin();
    }
    match /eventSchedule/{docId} {
      allow read, write: if true;
    }
    match /emergencyNotifications/{id} {
      allow read, write: if true;
    }
    match /notifCenterCleared/{viewerKey} {
      allow read, write: if true;
    }

    // ---- Stock requests (Ordering System) ----
    // Doc ID = "<YYYY-MM-DD>_<lowercase staffId>" -> one request per employee per day.
    // Employees do not use Firebase Auth, so reads and writes are open, but:
    //  - only fixed fields are allowed, with size limits
    //  - the doc ID must match the date and staffId
    //  - requests are locked server-side after that day's cutoff (Philippine time).
    //    The admin sets the cutoff in stockDays/<date>.cutoffMin (minutes after midnight; default 840 = 2 PM).
    function phNow() { return request.time + duration.time(8, 0, 0, 0); }
    function pad2(n) { return n < 10 ? '0' + string(n) : string(n); }
    function phDayStr(k) {
      let t = request.time + duration.time(8, 0, 0, 0) + duration.value(k, 'd');
      return string(t.year()) + '-' + pad2(t.month()) + '-' + pad2(t.day());
    }
    // Open if: (1) today in Philippine time and before the cutoff, or (2) any of the next 7 days.
    function stockOpen(d, cm) {
      return (d == phDayStr(0) && (phNow().hours() * 60 + phNow().minutes()) < cm)
          || d in [phDayStr(1), phDayStr(2), phDayStr(3), phDayStr(4), phDayStr(5), phDayStr(6), phDayStr(7)];
    }
    function stockDataOk(reqId) {
      return request.resource.data.keys().hasOnly(['staffId','name','siteName','branch','sr','removedSr','srSearchTerms','date','day','updatedAt','history','status','removalReason','removedAt','removedBy','removalViewedAt','adminCompleted','adminCompletedAt','adminCompletedBy'])
          && request.resource.data.staffId is string
          && request.resource.data.name is string
          && request.resource.data.siteName is string
            && (!('removedSr' in request.resource.data)
              || (request.resource.data.removedSr is string && request.resource.data.removedSr.size() <= 100))
              && (!('srSearchTerms' in request.resource.data)
                || (request.resource.data.srSearchTerms is list && request.resource.data.srSearchTerms.size() <= 30))
        && (!('branch' in request.resource.data)
          || (request.resource.data.branch is string && request.resource.data.branch in ['north','south']))
        && ((!('status' in request.resource.data)
           && !('removalReason' in request.resource.data)
           && !('removedAt' in request.resource.data))
          || (request.resource.data.status == 'removed'
            && request.resource.data.removalReason is string
            && request.resource.data.removalReason.size() >= 5
            && request.resource.data.removalReason.size() <= 200
            && request.resource.data.removedAt is timestamp))
          && (!('removedBy' in request.resource.data) || request.resource.data.removedBy in ['employee','admin'])
          && (!('removalViewedAt' in request.resource.data) || request.resource.data.removalViewedAt is timestamp)
            && (!('adminCompleted' in request.resource.data) || request.resource.data.adminCompleted is bool)
            && (!('adminCompletedAt' in request.resource.data) || request.resource.data.adminCompletedAt is timestamp)
            && (!('adminCompletedBy' in request.resource.data) || request.resource.data.adminCompletedBy is string)
            && ((!('adminCompleted' in request.resource.data) && !('adminCompletedAt' in request.resource.data) && !('adminCompletedBy' in request.resource.data))
              || (request.resource.data.adminCompleted == true && request.resource.data.adminCompletedAt is timestamp && request.resource.data.adminCompletedBy is string))
          && request.resource.data.sr is string
          && ((request.resource.data.get('status', '') == 'removed' && request.resource.data.sr.size() == 0)
              || (request.resource.data.get('status', '') != 'removed' && request.resource.data.sr.size() > 0))
          && request.resource.data.sr.size() <= 100
          && request.resource.data.date is string
          && request.resource.data.day is string
          && reqId == request.resource.data.date + '_' + request.resource.data.staffId.lower();
    }
    // When the SR# changes on an existing request, history must include a new entry
    // (oldSr, newSr, reason 5-200 chars). If the SR# is unchanged, history must remain unchanged.
    function stockChangeOk() {
      let h = request.resource.data.get('history', []);
      let old = resource.data.get('history', []);
      return request.resource.data.sr == resource.data.sr
        ? h == old
        : (h is list && h.size() == old.size() + 1 && h.size() <= 10
           && h[h.size() - 1].oldSr == resource.data.sr
           && h[h.size() - 1].newSr == request.resource.data.sr
           && h[h.size() - 1].reason is string
           && h[h.size() - 1].reason.size() >= 5
           && h[h.size() - 1].reason.size() <= 200);
    }
    function stockRemovalOk() {
      return resource.data.get('status', '') != 'removed'
          && request.resource.data.status == 'removed'
          && request.resource.data.removedBy == 'employee'
          && request.resource.data.sr == ''
          && request.resource.data.get('history', []) == resource.data.get('history', []);
    }
        function stockAdminRemoveOk() {
      return isAdmin()
          && resource.data.get('status', '') != 'removed'
          && request.resource.data.status == 'removed'
          && request.resource.data.removedBy == 'admin'
          && request.resource.data.sr == ''
          && request.resource.data.date == resource.data.date
          && request.resource.data.staffId == resource.data.staffId
          && request.resource.data.get('history', []) == resource.data.get('history', []);
        }
    function stockAdminCompleteOk() {
      return isAdmin()
          && resource.data.get('status', '') != 'removed'
          && resource.data.get('adminCompleted', false) != true
          && resource.data.sr is string
          && resource.data.sr.size() > 0
          && request.resource.data.adminCompleted == true
          && request.resource.data.adminCompletedAt is timestamp
          && request.resource.data.adminCompletedBy == request.auth.token.email
          && request.resource.data.sr == resource.data.sr
          && request.resource.data.date == resource.data.date
          && request.resource.data.staffId == resource.data.staffId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminCompleted','adminCompletedAt','adminCompletedBy']);
    }
    function stockReopenOk() {
      return resource.data.get('status', '') == 'removed'
          && !('status' in request.resource.data)
          && !('removalReason' in request.resource.data)
          && !('removedAt' in request.resource.data)
          && !('removedBy' in request.resource.data)
          && !('removalViewedAt' in request.resource.data)
          && !('history' in request.resource.data);
    }
        function stockAdminMarkRemovalViewed() {
      return isAdmin()
          && resource.data.get('status', '') == 'removed'
          && request.resource.data.status == 'removed'
          && request.resource.data.removalViewedAt is timestamp
          && !('removalViewedAt' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['removalViewedAt']);
        }
    // The admin activates a day: stockDays/<YYYY-MM-DD> = { active: true }.
    // Employees cannot create, update, or delete requests until that date has an active document.
    // Per-employee schedule: employees/<staffId>.requestDays = ['TUESDAY', ...]
    // If requestDays is absent, all days are allowed.
    function empAllowedDay(staffId, day) {
      let e = get(/databases/$(database)/documents/employees/$(staffId.lower())).data;
      return e.get('requestDays', null) == null || day in e.requestDays;
    }
    function stockRequester(staffId) {
      let employee = get(/databases/$(database)/documents/employees/$(staffId.lower())).data;
      let department = employee.get('department', '');
      return department is string
          && department.lower().matches('^(billing|pharmacist|pharmacy assistant)( north| south)?$');
    }
    // The date must be active (by admin), match the weekday, and be allowed by the employee's schedule.
    function stockDayActive(d, staffId, day) {
      return exists(/databases/$(database)/documents/stockDays/$(d))
          && get(/databases/$(database)/documents/stockDays/$(d)).data.active == true
          && get(/databases/$(database)/documents/stockDays/$(d)).data.day == day
          && stockOpen(d, get(/databases/$(database)/documents/stockDays/$(d)).data.get('cutoffMin', 840))
          && empAllowedDay(staffId, day);
    }
    match /stockDays/{day} {
      allow read: if true;
      allow create, update: if isAdmin()
                            && request.resource.data.keys().hasOnly(['active','date','day','activatedAt','cutoffMin'])
                            && (!('cutoffMin' in request.resource.data) || (request.resource.data.cutoffMin is int
                                && request.resource.data.cutoffMin >= 0 && request.resource.data.cutoffMin <= 1439))
                            && request.resource.data.active is bool
                            && day == request.resource.data.date;
      allow delete: if isAdmin();
    }
    match /stockRequests/{reqId} {
      allow read: if true;
      allow create: if stockDataOk(reqId)
                    && stockRequester(request.resource.data.staffId)
                    && !('history' in request.resource.data)
            && !('status' in request.resource.data)
                    && stockDayActive(request.resource.data.date, request.resource.data.staffId, request.resource.data.day);
      allow update: if stockDataOk(reqId)
                && ((isAdmin() && stockAdminRemoveOk())
                  || stockAdminCompleteOk()
                || (stockRequester(request.resource.data.staffId)
                   && resource.data.get('adminCompleted', false) != true
                         && (stockChangeOk() || stockRemovalOk() || stockReopenOk())
              && request.resource.data.date == resource.data.date
              && stockDayActive(request.resource.data.date, request.resource.data.staffId, request.resource.data.day))
                || stockAdminMarkRemovalViewed());
        allow delete: if isAdmin()
              || (stockRequester(resource.data.staffId)
                && resource.data.get('adminCompleted', false) != true
                && stockDayActive(resource.data.date, resource.data.staffId, resource.data.day));
    }
      match /stockRequestHistory/{historyId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
  }
}
