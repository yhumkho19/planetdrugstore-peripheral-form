          && !getAfter(/databases/$(database)/documents/dailyTasks/$(taskId)/history/$(request.resource.data.lastEditId)).data.after.keys().hasAny(['attachments'])
          && getAfter(/databases/$(database)/documents/dailyTasks/$(taskId)/history/$(request.resource.data.lastEditId)).data.after.date == request.resource.data.date
