rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.get('email', '') is string
        && request.auth.token.get('email', '').matches('^.+@.+$')
        && !request.auth.token.get('email', '').matches('.*@staff[.]planetdrugstore[.]local$')
        && request.auth.token.get('email', '').lower() != 'departments.editor@planetdrugstore.ph'
        && !isViewer();
    }
    function isViewer() {
      return request.auth != null
        && request.auth.token.get('email', '').lower() == 'pdsviewing@planetdrugstore.ph';
    }
    function isDepartmentDirectoryEditor() {
      return request.auth != null
        && request.auth.token.get('email', '').lower() == 'departments.editor@planetdrugstore.ph'
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function isBillingDailyTaskProfileUser() {
      return request.auth != null
        && (request.auth.token.get('email', '').lower() == 'billingdepart@planetdrugstore.ph'
          || (request.auth.token.get('employee', false) == true
            && request.auth.token.firebase.sign_in_provider == 'custom'
            && request.auth.token.get('staffId', '') is string
            && exists(/databases/$(database)/documents/employees/$(request.auth.token.staffId.lower()))
            && get(/databases/$(database)/documents/employees/$(request.auth.token.staffId.lower())).data.get('department', '')
              .lower().matches('^billing( north| south| manila)?$')));
    }
    function ownsDailyTaskProfilePhoto(profileKey) {
      return isBillingDailyTaskProfileUser()
        && ((profileKey == 'billing-head'
            && request.auth.token.get('email', '').lower() == 'billingdepart@planetdrugstore.ph')
          || (request.auth.token.get('employee', false) == true
            && request.auth.token.get('staffId', '') is string
            && request.auth.token.staffId.lower() == profileKey));
    }
    function isProfiledEmployee() {
      return request.auth != null
        && !isViewer()
        && request.auth.token.get('employee', false) == true
        && request.auth.token.firebase.sign_in_provider == 'custom'
        && request.auth.token.get('staffId', '') is string
        && exists(/databases/$(database)/documents/employees/$(request.auth.token.staffId.lower()));
    }
    function canReadRosterProfilePhotos() {
      return request.auth != null
        && (isProfiledEmployee()
          || request.auth.token.get('email', '').lower() in [
            'pharmacistdepart@planetdrugstore.ph',
            'billingdepart@planetdrugstore.ph',
            'informationdepart@planetdrugstore.ph'
          ]
          || (exists(/databases/$(database)/documents/eventScheduleAdmins/$(request.auth.uid))
            && get(/databases/$(database)/documents/eventScheduleAdmins/$(request.auth.uid)).data.get('active', false) == true
            && get(/databases/$(database)/documents/eventScheduleAdmins/$(request.auth.uid)).data.get('role', '') == 'pharmacist'));
    }
    function ownsRosterProfilePhoto(profileKey) {
      return isProfiledEmployee()
        && request.auth.token.staffId.lower() == profileKey;
    }
    function validSelfRegistration(staffId) {
      let employee = request.resource.data;
      return employee.keys().hasOnly([
          'name', 'email', 'staffId', 'department', 'branch', 'siteName',
          'passwordHash', 'createdAt', 'createdBy'
        ])
        && employee.keys().hasAll([
          'name', 'email', 'staffId', 'department', 'branch', 'siteName',
          'passwordHash', 'createdAt', 'createdBy'
        ])
        && employee.name is string
        && employee.name.size() >= 2
        && employee.name.size() <= 120
        && employee.email is string
        && employee.email.size() <= 254
        && employee.email.matches('^.+@.+[.].+$')
        && employee.staffId is string
        && employee.staffId.size() >= 1
        && employee.staffId.size() <= 40
        && employee.staffId.matches('^[A-Za-z0-9._-]+$')
        && staffId == employee.staffId.lower()
        && employee.department in [
          'IT NORTH', 'IT SOUTH',
          'BILLING NORTH', 'BILLING SOUTH', 'BILLING MANILA',
          'PHARMACIST NORTH', 'PHARMACIST SOUTH',
          'Pharmacy Assistant NORTH', 'Pharmacy Assistant SOUTH'
        ]
        && employee.branch in ['north', 'south', 'manila']
        && ((employee.department in [
              'IT NORTH', 'BILLING NORTH', 'PHARMACIST NORTH',
              'Pharmacy Assistant NORTH'
            ] && employee.branch == 'north')
          || (employee.department in [
              'IT SOUTH', 'BILLING SOUTH', 'PHARMACIST SOUTH',
              'Pharmacy Assistant SOUTH'
            ] && employee.branch == 'south')
          || (employee.department == 'BILLING MANILA' && employee.branch == 'manila'))
        && employee.siteName is string
        && employee.siteName.size() >= 1
        && employee.siteName.size() <= 120
        && employee.passwordHash is string
        && employee.passwordHash.matches('^[a-f0-9]{64}$')
        && employee.createdAt == request.time
        && employee.createdBy == 'self-registration'
        && exists(/databases/$(database)/documents/config/employeeRegistration)
        && get(/databases/$(database)/documents/config/employeeRegistration).data.get('registrationEnabled', false) == true;
    }
    function isPharmacyScheduleOwner() {
      return request.auth != null
        && request.auth.token.get('email', '') == 'pharmacistdepart@planetdrugstore.ph';
    }
    function isBillingScheduleOwner() {
      return request.auth != null
        && request.auth.token.get('email', '') == 'billingdepart@planetdrugstore.ph';
    }
    function isPharmacistScheduleAdmin() {
      return request.auth != null
        && !isViewer()
        && (isPharmacyScheduleOwner()
          || (exists(/databases/$(database)/documents/eventScheduleAdmins/$(request.auth.uid))
            && get(/databases/$(database)/documents/eventScheduleAdmins/$(request.auth.uid)).data.get('active', false) == true
            && get(/databases/$(database)/documents/eventScheduleAdmins/$(request.auth.uid)).data.get('role', '') == 'pharmacist'));
    }
    function pharmacistPresenceNameMatches() {
      return isPharmacyScheduleOwner()
        ? request.resource.data.name in ['Operations', 'Pharmacist']
        : request.resource.data.name == get(/databases/$(database)/documents/eventScheduleAdmins/$(request.auth.uid)).data.name;
    }

    match /employees/{staffId} {
      allow get: if isAdmin()
        || isViewer()
        || (request.auth != null
          && request.auth.token.get('employee', false) == true
          && request.auth.token.get('staffId', '') is string
          && request.auth.token.staffId.lower() == staffId);
      allow list: if isAdmin() || isViewer();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /departmentDirectory/{departmentId} {
      function validDepartmentEntry() {
        return departmentId in [
            'it', 'purchasing', 'hr', 'warehouse', 'billing', 'accounting', 'operation'
          ]
          && request.resource.data.keys().hasOnly([
            'head', 'email', 'phone', 'location', 'hours', 'updatedAt', 'updatedBy'
          ])
          && request.resource.data.keys().hasAll([
            'head', 'email', 'phone', 'location', 'hours', 'updatedAt', 'updatedBy'
          ])
          && request.resource.data.head is string
          && request.resource.data.head.size() <= 120
          && request.resource.data.email is string
          && request.resource.data.email.size() <= 254
          && request.resource.data.phone is string
          && request.resource.data.phone.size() <= 60
          && request.resource.data.location is string
          && request.resource.data.location.size() <= 160
          && request.resource.data.hours is string
          && request.resource.data.hours.size() <= 120
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.token.email;
      }
      allow read: if true;
      allow create, update: if isDepartmentDirectoryEditor() && validDepartmentEntry();
      allow delete: if false;
    }

    function validCustomDepartmentTeamPositionId(positionId) {
      return positionId.matches('^it-custom-[a-f0-9]{32}$');
    }

    match /departmentTeamPositions/{positionId} {
      function validDepartmentTeamPosition() {
        let position = request.resource.data;
        return position.keys().hasOnly([
            'department', 'team', 'level', 'label', 'createdAt', 'createdBy'
          ])
          && position.keys().hasAll([
            'department', 'team', 'level', 'label', 'createdAt', 'createdBy'
          ])
          && position.department == 'it'
          && position.team in [
            'System Administration', 'Infrastructure', 'User Support & Service'
          ]
          && position.level in ['Manager', 'Team Leader', 'Senior', 'Junior']
          && position.label is string
          && position.label.size() > 0
          && position.label.size() <= 80
          && position.createdAt == request.time
          && position.createdBy == request.auth.token.email;
      }
      allow get, list: if true;
      allow create: if isDepartmentDirectoryEditor()
        && validCustomDepartmentTeamPositionId(positionId)
        && validDepartmentTeamPosition();
      allow update, delete: if false;
    }

    match /departmentTeamProfiles/{profileId} {
      function validDepartmentTeamProfile() {
        return (profileId in [
            'it-head',
            'it-sys-ad-team-leader', 'it-sys-ad-senior-1',
            'it-infrastructure-team-leader', 'it-infrastructure-junior-1',
            'it-user-support-team-leader',
            'it-user-support-senior-1', 'it-user-support-senior-2', 'it-user-support-senior-3',
            'it-user-support-junior-1', 'it-user-support-junior-2', 'it-user-support-junior-3',
            'it-user-support-junior-4', 'it-user-support-junior-5', 'it-user-support-junior-6',
            'it-user-support-junior-7'
          ]
          || (validCustomDepartmentTeamPositionId(profileId)
            && exists(/databases/$(database)/documents/departmentTeamPositions/$(profileId))))
          && request.resource.data.keys().hasOnly([
            'department', 'name', 'bio', 'photoData', 'updatedAt', 'updatedBy'
          ])
          && request.resource.data.keys().hasAll([
            'department', 'name', 'bio', 'photoData', 'updatedAt', 'updatedBy'
          ])
          && request.resource.data.department == 'it'
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.bio is string
          && request.resource.data.bio.size() <= 240
          && (request.resource.data.photoData == null
            || (request.resource.data.photoData is string
              && request.resource.data.photoData.size() <= 180000
              && request.resource.data.photoData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+=*$')))
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.token.email;
      }
      allow get: if true;
      allow list: if false;
      allow create, update: if isDepartmentDirectoryEditor() && validDepartmentTeamProfile();
      allow delete: if false;
    }

    match /userProfiles/{uid} {
      function validUserProfile() {
        return request.resource.data.keys().hasOnly([
            'displayName', 'about', 'photoData', 'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'displayName', 'about', 'photoData', 'updatedAt'
          ])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 120
          && request.resource.data.about is string
          && request.resource.data.about.size() <= 300
          && (request.resource.data.photoData == null
            || (request.resource.data.photoData is string
              && request.resource.data.photoData.size() <= 180000
              && request.resource.data.photoData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+=*$')))
          && request.resource.data.updatedAt == request.time;
      }
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if request.auth != null
        && !isViewer()
        && request.auth.uid == uid
        && validUserProfile();
      allow delete: if false;
    }

    match /dailyTaskProfilePhotos/{profileKey} {
      function validProfilePhoto() {
        return request.resource.data.keys().hasOnly(['photoData', 'displayName', 'updatedAt'])
          && request.resource.data.keys().hasAll(['photoData', 'updatedAt'])
          && (request.resource.data.photoData == null
            || (request.resource.data.photoData is string
              && request.resource.data.photoData.size() <= 180000
              && request.resource.data.photoData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+=*$')))
          && (!request.resource.data.keys().hasAny(['displayName'])
            || (request.resource.data.displayName is string
              && request.resource.data.displayName.size() > 0
              && request.resource.data.displayName.size() <= 120))
          && request.resource.data.updatedAt == request.time;
      }
      allow get: if canReadRosterProfilePhotos() || isViewer();
      allow list: if false;
      allow create, update: if request.auth != null
        && profileKey.matches('^[a-z0-9._-]+$')
        && (ownsDailyTaskProfilePhoto(profileKey) || ownsRosterProfilePhoto(profileKey))
        && validProfilePhoto();
      allow delete: if false;
    }

    match /billingEmployeeConversations/{staffId} {
      function validParticipants() {
        return staffId == staffId.lower()
          && exists(/databases/$(database)/documents/employees/$(staffId))
          && request.resource.data.staffId == staffId
          && request.resource.data.employeeName
            == get(/databases/$(database)/documents/employees/$(staffId)).data.name
          && request.resource.data.department
            == get(/databases/$(database)/documents/employees/$(staffId)).data.department
          && request.resource.data.department.lower()
            in ['billing north', 'billing south', 'billing manila'];
      }
      function validMessageMetadata() {
        return request.resource.data.lastMessage is string
          && request.resource.data.lastMessage.size() <= 1000
          && request.resource.data.lastMessageAt == request.time
          && request.resource.data.lastMessageBy in ['billingHead', 'employee']
          && request.resource.data.unreadForEmployee is bool
          && request.resource.data.unreadForHead is bool
          && request.resource.data.updatedAt == request.time;
      }
      allow read: if isViewer() || isBillingScheduleOwner() || dailyTaskEmployee(staffId);
      allow list: if isBillingScheduleOwner();
      allow create: if isBillingScheduleOwner()
        && request.resource.data.keys().hasOnly([
          'staffId', 'employeeName', 'department', 'createdAt', 'updatedAt',
          'lastMessage', 'lastMessageAt', 'lastMessageBy', 'unreadForEmployee',
          'unreadForHead'
        ])
        && request.resource.data.keys().hasAll([
          'staffId', 'employeeName', 'department', 'createdAt', 'updatedAt',
          'lastMessage', 'lastMessageAt', 'lastMessageBy', 'unreadForEmployee',
          'unreadForHead'
        ])
        && validParticipants()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessage == ''
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.lastMessageBy == ''
        && request.resource.data.unreadForEmployee == false
        && request.resource.data.unreadForHead == false;
      allow update: if (isBillingScheduleOwner() || dailyTaskEmployee(staffId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastMessageAt', 'lastMessageBy',
          'unreadForEmployee', 'unreadForHead', 'updatedAt'
        ])
        && validMessageMetadata()
        && ((isBillingScheduleOwner()
            && request.resource.data.lastMessageBy == 'billingHead'
            && request.resource.data.unreadForEmployee == true
            && request.resource.data.unreadForHead == false)
          || (dailyTaskEmployee(staffId)
            && request.resource.data.lastMessageBy == 'employee'
            && request.resource.data.unreadForEmployee == false
            && request.resource.data.unreadForHead == true));
      allow update: if isBillingScheduleOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['unreadForHead', 'updatedAt'])
        && request.resource.data.unreadForHead == false
        && request.resource.data.updatedAt == request.time;
      allow update: if dailyTaskEmployee(staffId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['unreadForEmployee', 'updatedAt'])
        && request.resource.data.unreadForEmployee == false
        && request.resource.data.updatedAt == request.time;
      allow update: if isBillingScheduleOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['billingHeadActiveAt'])
        && request.resource.data.billingHeadActiveAt == request.time;
      allow update: if dailyTaskEmployee(staffId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['employeeActiveAt'])
        && request.resource.data.employeeActiveAt == request.time;
      allow delete: if false;

      match /messages/{messageId} {
        function parentConversationPath() {
          return /databases/$(database)/documents/billingEmployeeConversations/$(staffId);
        }
        allow read: if isViewer() || isBillingScheduleOwner() || dailyTaskEmployee(staffId);
        allow create: if exists(parentConversationPath())
          && request.resource.data.keys().hasOnly([
            'senderRole', 'senderId', 'body', 'sentAt', 'readAt'
          ])
          && request.resource.data.keys().hasAll([
            'senderRole', 'senderId', 'body', 'sentAt', 'readAt'
          ])
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 1000
          && request.resource.data.sentAt == request.time
          && request.resource.data.readAt == null
          && ((isBillingScheduleOwner()
              && request.resource.data.senderRole == 'billingHead'
              && request.resource.data.senderId == request.auth.token.get('email', ''))
            || (dailyTaskEmployee(staffId)
              && request.resource.data.senderRole == 'employee'
              && request.resource.data.senderId == request.auth.token.staffId));
        allow update: if isBillingScheduleOwner()
          && resource.data.senderRole == 'employee'
          && resource.data.readAt == null
          && request.resource.data.keys().hasOnly([
            'senderRole', 'senderId', 'body', 'sentAt', 'readAt'
          ])
          && request.resource.data.keys().hasAll([
            'senderRole', 'senderId', 'body', 'sentAt', 'readAt'
          ])
          && request.resource.data.senderRole == resource.data.senderRole
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.body == resource.data.body
          && request.resource.data.sentAt == resource.data.sentAt
          && request.resource.data.readAt is timestamp;
        allow update: if dailyTaskEmployee(staffId)
          && resource.data.senderRole == 'billingHead'
          && resource.data.readAt == null
          && request.resource.data.keys().hasOnly([
            'senderRole', 'senderId', 'body', 'sentAt', 'readAt'
          ])
          && request.resource.data.keys().hasAll([
            'senderRole', 'senderId', 'body', 'sentAt', 'readAt'
          ])
          && request.resource.data.senderRole == resource.data.senderRole
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.body == resource.data.body
          && request.resource.data.sentAt == resource.data.sentAt
          && request.resource.data.readAt is timestamp;
        allow delete: if false;
      }
    }

    match /entries/{entryId} {
      allow read: if true;
      allow write: if !isViewer();
    }
    match /reservedControlNos/{controlNo} {
      allow read: if true;
      allow write: if !isViewer();
    }
    match /liveSessions/{controlNo} {
      allow read: if true;
      allow write: if !isViewer();
    }
    match /receivers/{id} {
      allow read: if true;
      allow write: if !isViewer();
    }
    match /returners/{id} {
      allow read: if true;
      allow write: if !isViewer();
    }
    match /venues/{id} {
      allow read: if true;
      allow write: if !isViewer();
    }
    match /config/{id} {
      allow read: if true;
      allow write: if id == 'employeeRegistration'
        ? isAdmin()
          && request.resource.data.keys().hasOnly(['registrationEnabled', 'updatedAt', 'updatedBy'])
          && request.resource.data.keys().hasAll(['registrationEnabled', 'updatedAt', 'updatedBy'])
          && request.resource.data.registrationEnabled is bool
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.token.email
        : isAdmin();
    }
    match /preparers/{id} {
      allow read, write: if isAdmin();
    }
    match /eventSchedule/{docId} {
      allow read: if true;
      allow write: if !isViewer();
    }
    match /eventScheduleAdmins/{adminUid} {
      allow get: if request.auth != null
        && (request.auth.uid == adminUid || isPharmacyScheduleOwner());
      allow list: if isPharmacyScheduleOwner();
      allow create, update: if isPharmacyScheduleOwner()
        && request.resource.data.keys().hasOnly(['name','email','role','active','createdAt','createdBy','deleted','deletedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.role == 'pharmacist'
        && request.resource.data.active is bool
        && (!('deleted' in request.resource.data) || request.resource.data.deleted is bool)
        && (!('deletedAt' in request.resource.data) || request.resource.data.deletedAt is timestamp)
        && (request.resource.data.get('deleted', false) != true
          || (request.resource.data.active == false && request.resource.data.deletedAt is timestamp));
      allow delete: if isPharmacyScheduleOwner();
    }
    match /eventSchedulePresence/{adminUid} {
      allow read: if isPharmacistScheduleAdmin();
      allow create, update: if isPharmacistScheduleAdmin()
        && request.auth.uid == adminUid
        && request.resource.data.keys().hasOnly(['name','x','y','updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && pharmacistPresenceNameMatches()
        && request.resource.data.x is number
        && request.resource.data.x >= 0
        && request.resource.data.x <= 100
        && request.resource.data.y is number
        && request.resource.data.y >= 0
        && request.resource.data.y <= 100
        && request.resource.data.updatedAt == request.time;
      allow delete: if isPharmacistScheduleAdmin() && request.auth.uid == adminUid;
    }
    match /eventScheduleArchive/{eventId} {
      allow read: if true;
      allow write: if !isViewer();
    }
    match /emergencyNotifications/{id} {
      allow read: if true;
      allow write: if !isViewer();
    }
    match /notifCenterCleared/{viewerKey} {
      allow read: if true;
      allow write: if !isViewer();
    }

    // ---- Stock requests (Ordering System) ----
    // Medicine requests and legacy Medicine records use stockRequests.
    // Supplies requests use suppliesStockRequests and retain the _supplies ID suffix.
    // Employees do not use Firebase Auth, so reads and writes are open, but:
    //  - only fixed fields are allowed, with size limits
    //  - the doc ID must match the date and staffId
    //  - requests are locked server-side after that day's cutoff (Philippine time).
    //    The admin sets the cutoff in stockDays/<date>.cutoffMin (minutes after midnight; default 840 = 2 PM).
    function phNow() { return request.time + duration.time(8, 0, 0, 0); }
    function pad2(n) { return n < 10 ? '0' + string(n) : string(n); }
    function phDayStr(k) {
      let t = request.time + duration.time(8, 0, 0, 0) + duration.value(k, 'd');
      return string(t.year()) + '-' + pad2(t.month()) + '-' + pad2(t.day());
    }
    // Open if: (1) today in Philippine time and before the cutoff, or (2) any of the next 7 days.
    function stockOpen(d, cm) {
      let now = phNow();
      let today = phDayStr(0);
      let lastOpenDay = phDayStr(7);
      return (d == today && (now.hours() * 60 + now.minutes()) < cm)
          || (d.matches('^\\d{4}-\\d{2}-\\d{2}$') && d > today && d <= lastOpenDay);
    }
    function stockDayId(d, requestType) {
      return d + (requestType == 'supplies' ? '_supplies' : '');
    }
    function stockDataOk(reqId, expectedType) {
      return request.resource.data.keys().hasOnly(['staffId','name','siteName','branch','sr','removedSr','srSearchTerms','date','day','requestType','updatedAt','history','status','removalReason','removedAt','removedBy','removalViewedAt','adminCompleted','adminCompletedAt','adminCompletedBy'])
          && request.resource.data.staffId is string
          && request.resource.data.name is string
          && request.resource.data.siteName is string
            && (!('removedSr' in request.resource.data)
              || (request.resource.data.removedSr is string && request.resource.data.removedSr.size() <= 100))
              && (!('srSearchTerms' in request.resource.data)
                || (request.resource.data.srSearchTerms is list && request.resource.data.srSearchTerms.size() <= 30))
        && (!('branch' in request.resource.data)
          || (request.resource.data.branch is string && request.resource.data.branch in ['north','south','manila']))
        && ((!('status' in request.resource.data)
           && !('removalReason' in request.resource.data)
           && !('removedAt' in request.resource.data))
